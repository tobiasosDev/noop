# Local settings for Tools/testflight-upload.sh.
# Copy this file to ~/.config/noop/testflight.env (mode 600), or point
# NOOP_TESTFLIGHT_CONFIG at another path. The script reads KEY=VALUE lines.
# It does not execute the file. Blank lines and full-line # comments are
# ignored. Unknown keys are an error. Do not commit the filled-in file.
#
# Precedence: command-line flags, then environment variables of the same
# names, then this file, then the script defaults. Leave a key unset to
# keep the default. See docs/TESTFLIGHT.md.

# Apple Developer Team ID, from Membership details.
TEAM_ID=ABCDE12345

# Reverse-DNS prefix. The iOS app bundle id is <prefix>.noop.
BUNDLE_ID_PREFIX=com.example

# App Group registered on the team. Passed through for this archive only.
APP_GROUP_ID=group.com.example.noop

# App Store Connect API key. The .p8 stays outside the repo.
# Omit ASC_KEY_PATH to use ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# automatic uses Xcode signing. manual uses installed App Store profiles.
EXPORT_SIGNING=manual

# Each profile is named "<PROFILE_PREFIX> <bundle id>" and is IOS_APP_STORE.
PROFILE_PREFIX=Example AppStore

# Keychain that holds the Apple Distribution private key, and the
# login-keychain generic-password service whose secret unlocks it.
# The password is never printed. Omit both to skip unlocking.
SIGNING_KEYCHAIN=/Users/you/Library/Keychains/release.keychain-db
SIGNING_KEYCHAIN_PASSWORD_SERVICE=release-keychain
